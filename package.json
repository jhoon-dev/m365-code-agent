{
  "name": "m365-code-agent",
  "displayName": "M365 Code Agent",
  "description": "%extension.description%",
  "version": "0.17.1",
  "publisher": "jhoon-dev",
  "author": "jhoon-dev",
  "preview": true,
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jhoon-dev/m365-code-agent.git"
  },
  "homepage": "https://github.com/jhoon-dev/m365-code-agent#readme",
  "bugs": {
    "url": "https://github.com/jhoon-dev/m365-code-agent/issues"
  },
  "keywords": [
    "M365",
    "Copilot",
    "coding",
    "agent",
    "Edge",
    "Playwright"
  ],
  "galleryBanner": {
    "color": "#12243a",
    "theme": "dark"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "activationEvents": [
    "onView:m365Agent.chat",
    "onView:m365Agent.launcher",
    "onLanguageModelChatProvider:m365-code-agent"
  ],
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "m365-code-agent",
        "displayName": "M365 Code Agent (Experimental)"
      }
    ],
    "commands": [
      {
        "command": "m365Agent.open",
        "title": "%command.m365Agent.open.title%",
        "icon": "$(robot)"
      },
      {
        "command": "m365Agent.connect",
        "title": "%command.m365Agent.connect.title%"
      },
      {
        "command": "m365Agent.newChat",
        "title": "%command.m365Agent.newChat.title%"
      },
      {
        "command": "m365Agent.stop",
        "title": "%command.m365Agent.stop.title%"
      },
      {
        "command": "m365Agent.diagnostics",
        "title": "%command.m365Agent.diagnostics.title%"
      },
      {
        "command": "m365Agent.checkWorkspace",
        "title": "%command.m365Agent.checkWorkspace.title%"
      },
      {
        "command": "m365Agent.syncWeb",
        "title": "%command.m365Agent.syncWeb.title%"
      },
      {
        "command": "m365Agent.refreshModels",
        "title": "%command.m365Agent.refreshModels.title%"
      },
      {
        "command": "m365Agent.showBrowser",
        "title": "%command.m365Agent.showBrowser.title%"
      },
      {
        "command": "m365Agent.editorBrowser",
        "title": "%command.m365Agent.editorBrowser.title%"
      },
      {
        "command": "m365Agent.explainSelection",
        "title": "%command.m365Agent.explainSelection.title%",
        "category": "M365 Agent",
        "enablement": "isWorkspaceTrusted && resourceScheme == file && editorHasSelection"
      },
      {
        "command": "m365Agent.reviewSelection",
        "title": "%command.m365Agent.reviewSelection.title%",
        "category": "M365 Agent",
        "enablement": "isWorkspaceTrusted && resourceScheme == file && editorHasSelection"
      },
      {
        "command": "m365Agent.editSelection",
        "title": "%command.m365Agent.editSelection.title%",
        "category": "M365 Agent",
        "enablement": "isWorkspaceTrusted && resourceScheme == file && editorHasSelection && !editorReadonly"
      },
      {
        "command": "m365Agent.fixDiagnostic",
        "title": "%command.m365Agent.fixDiagnostic.title%",
        "category": "M365 Agent",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "m365Agent.mcpTools",
        "title": "%command.m365Agent.mcpTools.title%",
        "enablement": "isWorkspaceTrusted"
      }
    ],
    "submenus": [
      {
        "id": "m365Agent.editorMenu",
        "label": "M365 Agent"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "m365Agent.open",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "submenu": "m365Agent.editorMenu",
          "when": "isWorkspaceTrusted && resourceScheme == file && editorHasSelection",
          "group": "2_m365Agent"
        }
      ],
      "m365Agent.editorMenu": [
        {
          "command": "m365Agent.explainSelection",
          "group": "1_read@1"
        },
        {
          "command": "m365Agent.reviewSelection",
          "group": "1_read@2"
        },
        {
          "command": "m365Agent.editSelection",
          "group": "2_edit@1"
        }
      ],
      "commandPalette": [
        {
          "command": "m365Agent.fixDiagnostic",
          "when": "false"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "m365AgentLauncher",
          "title": "M365 Agent",
          "icon": "media/agent.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "m365Agent",
          "title": "M365 Agent",
          "icon": "media/agent.svg"
        }
      ]
    },
    "views": {
      "m365AgentLauncher": [
        {
          "id": "m365Agent.launcher",
          "name": "%view.launcher.name%"
        }
      ],
      "m365Agent": [
        {
          "type": "webview",
          "id": "m365Agent.chat",
          "name": "Code Agent"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "m365Agent.launcher",
        "contents": "%view.launcher.welcome%"
      }
    ],
    "configuration": {
      "title": "M365 Code Agent",
      "properties": {
        "m365Agent.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "ko"
          ],
          "default": "auto",
          "scope": "application",
          "enumItemLabels": [
            "%language.auto%",
            "English",
            "한국어"
          ],
          "description": "%language.description%"
        },
        "m365Agent.experimental.modelProvider.maxPromptCharacters": {
          "type": "number",
          "default": 120000,
          "minimum": 4000,
          "maximum": 120000,
          "scope": "application",
          "description": "%configuration.experimental.modelProvider.maxPromptCharacters.description%"
        },
        "m365Agent.experimental.modelProvider.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "%configuration.experimental.modelProvider.enabled.description%"
        },
        "m365Agent.copilotUrl": {
          "type": "string",
          "default": "https://m365.cloud.microsoft/chat",
          "description": "%configuration.copilotUrl.description%"
        },
        "m365Agent.browserChannel": {
          "type": "string",
          "enum": [
            "msedge",
            "chrome"
          ],
          "default": "msedge",
          "description": "%configuration.browserChannel.description%"
        },
        "m365Agent.maxRounds": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "maximum": 500,
          "multipleOf": 1,
          "description": "%configuration.maxRounds.description%"
        },
        "m365Agent.responseTimeoutSeconds": {
          "type": "number",
          "default": 240,
          "minimum": 30,
          "maximum": 900
        },
        "m365Agent.loginTimeoutSeconds": {
          "type": "number",
          "default": 600,
          "minimum": 30,
          "maximum": 1800,
          "description": "%configuration.loginTimeoutSeconds.description%"
        },
        "m365Agent.modelButtonSelector": {
          "type": "string",
          "default": "",
          "description": "%configuration.modelButtonSelector.description%"
        },
        "m365Agent.maxPromptCharacters": {
          "type": "number",
          "default": 120000,
          "minimum": 4000,
          "maximum": 120000,
          "description": "%configuration.maxPromptCharacters.description%"
        },
        "m365Agent.maxFileSizeMB": {
          "type": "number",
          "default": 16,
          "minimum": 1,
          "maximum": 128,
          "description": "%configuration.maxFileSizeMB.description%"
        },
        "m365Agent.commandOutputEncoding": {
          "type": "string",
          "enum": [
            "utf8",
            "cp949"
          ],
          "default": "utf8",
          "description": "%configuration.commandOutputEncoding.description%"
        },
        "m365Agent.composerSelector": {
          "type": "string",
          "default": "",
          "description": "%configuration.composerSelector.description%"
        },
        "m365Agent.sendButtonSelector": {
          "type": "string",
          "default": "",
          "description": "%configuration.sendButtonSelector.description%"
        },
        "m365Agent.responseSelector": {
          "type": "string",
          "default": "",
          "description": "%configuration.responseSelector.description%"
        },
        "m365Agent.browserView": {
          "type": "string",
          "enum": [
            "editor",
            "external"
          ],
          "default": "editor",
          "description": "%configuration.browserView.description%"
        },
        "m365Agent.attachmentMaxFileSizeMB": {
          "type": "number",
          "default": 64,
          "minimum": 1,
          "maximum": 512,
          "description": "%configuration.attachmentMaxFileSizeMB.description%"
        },
        "m365Agent.attachmentMaxTotalSizeMB": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "maximum": 1024,
          "description": "%configuration.attachmentMaxTotalSizeMB.description%"
        },
        "m365Agent.attachmentTimeoutSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 5,
          "maximum": 600,
          "description": "%configuration.attachmentTimeoutSeconds.description%"
        },
        "m365Agent.attachmentInputSelector": {
          "type": "string",
          "default": "",
          "description": "%configuration.attachmentInputSelector.description%"
        },
        "m365Agent.attachmentButtonSelector": {
          "type": "string",
          "default": "",
          "description": "%configuration.attachmentButtonSelector.description%"
        },
        "m365Agent.attachmentReadySelector": {
          "type": "string",
          "default": "",
          "description": "%configuration.attachmentReadySelector.description%"
        },
        "m365Agent.attachmentErrorSelector": {
          "type": "string",
          "default": "",
          "description": "%configuration.attachmentErrorSelector.description%"
        },
        "m365Agent.attachmentScopeSelector": {
          "type": "string",
          "default": "",
          "description": "%configuration.attachmentScopeSelector.description%"
        }
      }
    }
  },
  "scripts": {
    "prepackage": "node -e \"require('node:fs').mkdirSync('dist', { recursive: true })\"",
    "test": "node --test --test-concurrency=2 test/*.test.js",
    "test:integration": "node scripts/test-integration.cjs",
    "lint": "eslint src media/*.js scripts/*.cjs eslint.config.cjs",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "package": "node scripts/package.cjs",
    "typecheck": "tsc --project tsconfig.json",
    "format": "prettier --write \"src/**/*.js\" \"media/*.js\" \"scripts/*.cjs\" \"types/**/*.ts\" \"test/*.ts\" eslint.config.cjs prettier.config.cjs tsconfig.json",
    "format:check": "prettier --check \"src/**/*.js\" \"media/*.js\" \"scripts/*.cjs\" \"types/**/*.ts\" \"test/*.ts\" eslint.config.cjs prettier.config.cjs tsconfig.json",
    "clean:test-output": "node scripts/clean-test-output.cjs"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "ignore": "7.0.14",
    "markdown-it": "15.0.3",
    "playwright-core": "1.65.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/vscode": "1.106.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3"
  }
}
